<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site1.master.cs"
    Inherits="Presentacion.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Gestión Médica</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <link href="Styles/StyleSheet.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <script type="text/javascript">
    // Tiempo de sesión en minutos (coincidir con Web.config)
    var timeout = 1 * 60 * 1000; // 1 minuto en milisegundos

    setTimeout(function () {
        alert("Su sesión ha expirado por inactividad. Será redirigido al login.");
        window.location.href = 'Login.aspx';
    }, timeout);
</script>

</head>

<body>

    <form id="form1" runat="server">

        <!-- NAVBAR -->

        <nav class="navbar-custom" role="navigation">

            <!-- IZQUIERDA -->

            <div class="nav-left">

                <ul>

                    <li>
                        <a href="Menu.aspx">Inicio</a>
                    </li>

                    <li id="liUsuarios" runat="server">
                        <a href="CRUD_Usuarios.aspx">Usuarios</a>
                    </li>

                    <li id="liTurnos" runat="server">
                        <a href="Turnos.aspx">Turnos</a>
                    </li>

                    <li id="liRecetas" runat="server">
                        <a href="Recetas.aspx">Mis Recetas</a>
                    </li>

                    <li id="liMedicos" runat="server">
                        <a href="Medicos.aspx">Médicos</a>
                    </li>

                    <li id="liBitacora" runat="server">
                        <a href="Bitacora.aspx">Bitácora</a>
                    </li>
                     <li id="liSeguridad" runat="server">
                         <a href="Seguridad.aspx">Seguridad</a>
                     </li>
                </ul>

            </div>

            <!-- DERECHA -->

            <div class="user-info">
                <div class="nav-right">
                    <span class="usuario-logueado">
                        <i class="fa-solid fa-user-doctor" aria-hidden="true"></i>
                        Bienvenido,
                        <asp:Label ID="lblUsuario" runat="server">

                        </asp:Label>

                    </span>
                    <a class="logout-link" href="CerrarSesion.aspx"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Cerrar Sesión </a>

                </div>

            </div>

        </nav>

        <div class="vital-line" aria-hidden="true"></div>

        <!-- CONTENIDO -->

        <main class="contenido-principal">

            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">
            </asp:ContentPlaceHolder>

        </main>

    </form>

</body>

</html>
