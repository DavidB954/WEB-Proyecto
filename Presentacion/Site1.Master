<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site1.master.cs"
    Inherits="Presentacion.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Gestion Medica</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <link href="Styles/StyleSheet.css?v=2" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <script type="text/javascript">
    // Tiempo de sesion en minutos (coincidir con Web.config)
    var timeout = 20 * 60 * 1000; // 20 minutos en milisegundos

    setTimeout(function () {
        alert("Su sesion ha expirado por inactividad. Sera redirigido al login.");
        window.location.href = 'Login.aspx';
    }, timeout);
</script>

</head>

<body>

    <form id="form1" runat="server">


        <nav class="navbar-custom" role="navigation">


            <div class="nav-left">

                <ul>

                    <li>
                        <a id="aInicio" runat="server" data-i18n="1" href="Menu.aspx">Inicio</a>
                    </li>

                    <li id="liUsuarios" runat="server">
                        <a id="aUsuarios" runat="server" data-i18n="1" href="CRUD_Usuarios.aspx">Usuarios</a>
                    </li>

                    <li id="liTurnos" runat="server">
                        <a id="aTurnos" runat="server" data-i18n="1" href="Turnos.aspx">Turnos</a>
                    </li>

                    <li id="liRecetas" runat="server">
                        <a id="aRecetas" runat="server" data-i18n="1" href="Recetas.aspx">Mis Recetas</a>
                    </li>

                    <li id="liMedicos" runat="server">
                        <a id="aMedicos" runat="server" data-i18n="1" href="Medicos.aspx">Medicos</a>
                    </li>

                    <li id="liBitacora" runat="server">
                        <a id="aBitacora" runat="server" data-i18n="1" href="Bitacora.aspx">Bitacora</a>
                    </li>
                     <li id="liSeguridad" runat="server">
                         <a id="aSeguridad" runat="server" data-i18n="1" href="Seguridad.aspx">Seguridad</a>
                     </li>
                     <li id="liIdiomas" runat="server">
                         <a id="aIdiomas" runat="server" data-i18n="1" href="FormIdiomas.aspx">Idiomas</a>
                     </li>
                     <li id="liTraducciones" runat="server">
                         <a id="aTraducciones" runat="server" data-i18n="1" href="FormTraducciones.aspx">Traducciones</a>
                     </li>
                     <li id="liRolesPermisos" runat="server">
                         <a id="aRolesPermisos" runat="server" data-i18n="1" href="GestionRolesPermisos.aspx">Roles y Permisos</a>
                     </li>
                     <li id="liAsignacionSeguridad" runat="server">
                         <a id="aAsignacionSeguridad" runat="server" data-i18n="1" href="AsignacionSeguridad.aspx">Asignacion de Seguridad</a>
                     </li>
                </ul>

            </div>


            <div class="user-info">
                <div class="nav-right">

                    <asp:DropDownList ID="ddlIdioma" runat="server" CssClass="ddl-idioma"
                        DataTextField="Nombre" DataValueField="IdIdioma"
                        AutoPostBack="true" OnSelectedIndexChanged="ddlIdioma_SelectedIndexChanged">
                    </asp:DropDownList>

                    <span class="usuario-logueado">
                        <i class="fa-solid fa-user-doctor" aria-hidden="true"></i>
                        <span id="spanBienvenido" runat="server" data-i18n="1">Bienvenido,</span>
                        <asp:Label ID="lblUsuario" runat="server">

                        </asp:Label>

                    </span>
                    <a class="logout-link" href="CerrarSesion.aspx"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> <span id="spanCerrarSesion" runat="server" data-i18n="1">Cerrar Sesion</span></a>

                </div>

            </div>

        </nav>

        <div class="vital-line" aria-hidden="true"></div>


        <main class="contenido-principal">

            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">
            </asp:ContentPlaceHolder>

        </main>

    </form>

</body>

</html>
