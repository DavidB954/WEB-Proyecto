<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site1.master.cs"
    Inherits="Presentacion.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Gestion Medica</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <link href="Styles/StyleSheet.css?v=8" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <script type="text/javascript">
    var timeout = 20 * 60 * 1000;

    setTimeout(function () {
        mostrarAviso(<%= MensajeSesionExpirada %>, function () {
            window.location.href = 'Login.aspx';
        });
    }, timeout);

    (function () {
        var accionPendiente = null;
        var soloAviso = false;

        function abrir(mensaje, conCancelar, accion) {
            var dialogo = document.getElementById('dlgWeb');

            document.getElementById('dlgWebTexto').textContent = mensaje;
            document.getElementById('dlgWebCancelar').style.display = conCancelar ? '' : 'none';
            dialogo.classList.toggle('dialogo-web-aviso', !conCancelar);
            accionPendiente = accion || null;
            soloAviso = !conCancelar;

            if (!dialogo.open) {
                dialogo.showModal();
            }

            document.getElementById('dlgWebAceptar').focus();
        }

        function cerrar(ejecutar) {
            var accion = accionPendiente;

            accionPendiente = null;
            document.getElementById('dlgWeb').close();

            if (ejecutar && accion) {
                accion();
            }
        }

        window.confirmarAccion = function (control, mensaje) {
            if (control.getAttribute('data-confirmado')) {
                control.removeAttribute('data-confirmado');
                return true;
            }

            abrir(mensaje, true, function () {
                control.setAttribute('data-confirmado', '1');
                control.click();
            });

            return false;
        };

        window.mostrarAviso = function (mensaje, alCerrar) {
            abrir(mensaje, false, alCerrar);
        };

        document.addEventListener('click', function (e) {
            if (e.target.closest('#dlgWebAceptar')) {
                cerrar(true);
            } else if (e.target.closest('#dlgWebCancelar')) {
                cerrar(false);
            }
        });

        document.addEventListener('cancel', function (e) {
            if (e.target.id === 'dlgWeb') {
                e.preventDefault();
                cerrar(soloAviso);
            }
        }, true);
    })();
</script>

</head>

<body>

    <form id="form1" runat="server">


        <nav class="navbar-custom" role="navigation">


            <div class="nav-left">

                <ul>

                    <li>
                        <a id="aInicio" runat="server" data-i18n="1" href="Menu.aspx">Inicio</a>
                    </li>

                    <li id="liUsuarios" runat="server">
                        <a id="aUsuarios" runat="server" data-i18n="1" href="CRUD_Usuarios.aspx">Usuarios</a>
                    </li>

                    <li id="liTurnos" runat="server">
                        <a id="aTurnos" runat="server" data-i18n="1" href="Turnos.aspx">Turnos</a>
                    </li>

                    <li id="liRecetas" runat="server">
                        <a id="aRecetas" runat="server" data-i18n="1" href="Recetas.aspx">Mis Recetas</a>
                    </li>

                    <li id="liMedicos" runat="server">
                        <a id="aMedicos" runat="server" data-i18n="1" href="Medicos.aspx">Medicos</a>
                    </li>

                    <li id="liAgendaMedicos" runat="server">
                        <a id="aAgendaMedicos" runat="server" data-i18n="1" href="AgendaMedicos.aspx">Agenda Medicos</a>
                    </li>

                    <li id="liBitacora" runat="server">
                        <a id="aBitacora" runat="server" data-i18n="1" href="Bitacora.aspx">Bitacora</a>
                    </li>
                     <li id="liSeguridad" runat="server">
                         <a id="aSeguridad" runat="server" data-i18n="1" href="Seguridad.aspx">Seguridad</a>
                     </li>
                     <li id="liIdiomas" runat="server">
                         <a id="aIdiomas" runat="server" data-i18n="1" href="FormIdiomas.aspx">Idiomas</a>
                     </li>
                     <li id="liTraducciones" runat="server">
                         <a id="aTraducciones" runat="server" data-i18n="1" href="FormTraducciones.aspx">Traducciones</a>
                     </li>
                     <li id="liRolesPermisos" runat="server">
                         <a id="aRolesPermisos" runat="server" data-i18n="1" href="GestionRolesPermisos.aspx">Roles y Permisos</a>
                     </li>
                     <li id="liAsignacionSeguridad" runat="server">
                         <a id="aAsignacionSeguridad" runat="server" data-i18n="1" href="AsignacionSeguridad.aspx">Asignacion de Seguridad</a>
                     </li>
                </ul>

            </div>


            <div class="user-info">
                <div class="nav-right">

                    <asp:DropDownList ID="ddlIdioma" runat="server" CssClass="ddl-idioma"
                        DataTextField="Nombre" DataValueField="IdIdioma"
                        AutoPostBack="true" OnSelectedIndexChanged="ddlIdioma_SelectedIndexChanged">
                    </asp:DropDownList>

                    <span class="usuario-logueado">
                        <i class="fa-solid fa-user-doctor" aria-hidden="true"></i>
                        <span id="spanBienvenido" runat="server" data-i18n="1">Bienvenido,</span>
                        <asp:Label ID="lblUsuario" runat="server">

                        </asp:Label>

                    </span>
                    <a class="logout-link" href="CerrarSesion.aspx"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> <span id="spanCerrarSesion" runat="server" data-i18n="1">Cerrar Sesion</span></a>

                </div>

            </div>

        </nav>

        <div class="vital-line" aria-hidden="true"></div>


        <main class="contenido-principal">

            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">
            </asp:ContentPlaceHolder>

        </main>

        <dialog id="dlgWeb" class="dialogo-web" aria-labelledby="dlgWebTexto">
            <p id="dlgWebTexto"></p>
            <div class="dialogo-web-acciones">
                <button type="button" id="dlgWebCancelar" class="btn-base btn-warning"><span id="spanDialogoVolver" runat="server" data-i18n="1">Volver</span></button>
                <button type="button" id="dlgWebAceptar" class="btn-base btn-success"><span id="spanDialogoConfirmar" runat="server" class="dialogo-web-confirmar" data-i18n="1">Confirmar</span><span id="spanDialogoAceptar" runat="server" class="dialogo-web-aceptar" data-i18n="1">Aceptar</span></button>
            </div>
        </dialog>

    </form>

</body>

</html>
