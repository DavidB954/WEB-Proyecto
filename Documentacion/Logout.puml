@startuml Logout
title Diagrama de Secuencia - Logout (CerrarSesion.aspx)
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam wrapWidth 220

actor Usuario
boundary "CerrarSesion.aspx" as CerrarSesion
control "BLL_Bitacora" as BLL_Bitacora
entity "DAL_Bitacora" as DAL_Bitacora
entity "DAL_DVV" as DAL_DVV
control "EncryptionHelper" as EncryptionHelper
control "HashHelper" as HashHelper
database "Base de Datos" as BD

Usuario -> CerrarSesion : GET CerrarSesion.aspx\n(click "Cerrar sesión" o redirect automático por timeout de inactividad)
activate CerrarSesion

CerrarSesion -> CerrarSesion : usuarioLogueado = Session["Usuario"] as BE_Usuario

alt usuarioLogueado != null (habia una sesion activa)
    CerrarSesion -> BLL_Bitacora : RegistrarEvento(IdUsuario, LOGOUT, "LOGIN", "...")
    activate BLL_Bitacora
        BLL_Bitacora -> BLL_Bitacora : ObtenerIP()
        BLL_Bitacora --> BLL_Bitacora : return string

        BLL_Bitacora -> BLL_Bitacora : CriticidadBitacora.Obtener(LOGOUT)
        BLL_Bitacora --> BLL_Bitacora : return string

        BLL_Bitacora -> BLL_Bitacora : CadenaBitacora(objBitacora)
        BLL_Bitacora -> EncryptionHelper : Encriptar(cadena)
        EncryptionHelper --> BLL_Bitacora : return string

        BLL_Bitacora -> DAL_Bitacora : RegistrarEvento(objBitacora)
        activate DAL_Bitacora
            DAL_Bitacora -> BD : consulta a la base de datos
            BD --> DAL_Bitacora : OK
        DAL_Bitacora --> BLL_Bitacora : return void
        deactivate DAL_Bitacora

        BLL_Bitacora -> BLL_Bitacora : RefrescarDVVBitacora()
        activate BLL_Bitacora
            BLL_Bitacora -> DAL_Bitacora : ObtenerBitacora()
            activate DAL_Bitacora
                DAL_Bitacora -> BD : consulta a la base de datos
                BD --> DAL_Bitacora : filas
            DAL_Bitacora --> BLL_Bitacora : return List<BE_Bitacora>
            deactivate DAL_Bitacora

            BLL_Bitacora -> EncryptionHelper : Encriptar(CadenaBitacora(fila)) (por cada fila)
            EncryptionHelper --> BLL_Bitacora : return string

            BLL_Bitacora -> HashHelper : GenerarHash(concatenacion total)
            HashHelper --> BLL_Bitacora : return string

            BLL_Bitacora -> DAL_DVV : ActualizarDVV(dvvNuevo, "Bitacora")
            activate DAL_DVV
                DAL_DVV -> BD : consulta a la base de datos
                BD --> DAL_DVV : OK
            DAL_DVV --> BLL_Bitacora : return void
            deactivate DAL_DVV
        deactivate BLL_Bitacora
    BLL_Bitacora --> CerrarSesion : return void
    deactivate BLL_Bitacora
else usuarioLogueado == null (la sesion ya habia expirado)
    note over CerrarSesion : No hay usuario para identificar en la bitácora;\nno se registra ningún evento.
end

CerrarSesion -> CerrarSesion : Session.Clear()
CerrarSesion -> CerrarSesion : Session.Abandon()
CerrarSesion --> Usuario : Redirect("Login.aspx")
deactivate CerrarSesion

@enduml
