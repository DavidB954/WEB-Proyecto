@startuml Bitacora
title Diagrama de Secuencia - Bitácora (Bitacora.aspx: acceso, listado, filtros y paginación)
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam wrapWidth 220

actor Usuario
boundary "Bitacora.aspx" as Bitacora
control "SeguridadHelper" as Seguridad
control "BLL_Usuario" as BLL_Usuario
control "BLL_Bitacora" as BLL_Bitacora
entity "DAL_Usuario" as DAL_Usuario
entity "DAL_Bitacora" as DAL_Bitacora
database "Base de Datos" as BD

== Page_Load (primera carga, !IsPostBack) ==

Usuario -> Bitacora : GET Bitacora.aspx
activate Bitacora

Bitacora -> Bitacora : usuarioLogueado = Session["Usuario"] as BE_Usuario
Bitacora -> Seguridad : TieneAcceso(usuarioLogueado, "WEBMASTER", "ADMINISTRADOR")
activate Seguridad
Seguridad --> Bitacora : return bool
deactivate Seguridad

alt !TieneAcceso
    alt usuarioLogueado == null
        Bitacora --> Usuario : Redirect("Login.aspx")
    else usuario sin rol permitido
        Bitacora --> Usuario : Redirect("AccesoDenegado.aspx")
    end
else acceso permitido (WEBMASTER o ADMINISTRADOR)

    Bitacora -> Bitacora : CargarUsuarios()
    activate Bitacora
        Bitacora -> BLL_Usuario : Usuarios()
        activate BLL_Usuario
            BLL_Usuario -> DAL_Usuario : Usuarios()
            activate DAL_Usuario
                DAL_Usuario -> BD : consulta a la base de datos
                BD --> DAL_Usuario : filas
            DAL_Usuario --> BLL_Usuario : return List<BE_Usuario>
            deactivate DAL_Usuario
        BLL_Usuario --> Bitacora : return List<BE_Usuario>
        deactivate BLL_Usuario
        Bitacora -> Bitacora : ddlUsuarios.DataBind()\nInsert(0, "Todos","")
    deactivate Bitacora

    Bitacora -> Bitacora : CargarModulos()\n(items fijos: Todos, LOGIN, USUARIO, SEGURIDAD, ROL)
    Bitacora -> Bitacora : CargarCriticidades()\n(items fijos: Todas, ALTA, MEDIA, BAJA)

    Bitacora -> Bitacora : CargarGrilla()
    activate Bitacora
        Bitacora -> Bitacora : parsear filtros (desde, hasta, idUsuario, modulo, ip, criticidad)
        alt sin ningun filtro aplicado
            Bitacora -> BLL_Bitacora : ObtenerBitacora()
            activate BLL_Bitacora
                BLL_Bitacora -> DAL_Bitacora : ObtenerBitacora()
                activate DAL_Bitacora
                    DAL_Bitacora -> BD : consulta a la base de datos
                    BD --> DAL_Bitacora : filas
                DAL_Bitacora --> BLL_Bitacora : return List<BE_Bitacora>
                deactivate DAL_Bitacora
            BLL_Bitacora --> Bitacora : return List<BE_Bitacora>
            deactivate BLL_Bitacora
            Bitacora -> Bitacora : OrderByDescending(IdBitacora)
        else con al menos un filtro
            Bitacora -> BLL_Bitacora : FiltrarBitacora(desde, hasta, idUsuario, modulo, ip, criticidad)
            activate BLL_Bitacora
                BLL_Bitacora -> DAL_Bitacora : FiltrarBitacora(desde, hasta, idUsuario, modulo, ip, criticidad)
                activate DAL_Bitacora
                    DAL_Bitacora -> BD : consulta a la base de datos
                    BD --> DAL_Bitacora : resultado (DataAdapter.Fill)
                DAL_Bitacora --> BLL_Bitacora : return DataTable
                deactivate DAL_Bitacora
            BLL_Bitacora --> Bitacora : return DataTable
            deactivate BLL_Bitacora
            Bitacora -> Bitacora : dt.DefaultView.Sort = "IdBitacora DESC"
        end
        Bitacora -> Bitacora : gvBitacora.DataBind()
        alt gvBitacora.PageCount == 0
            Bitacora -> Bitacora : lblPaginas.Text = "Sin resultados"
        else
            Bitacora -> Bitacora : lblPaginas.Text = "Página X de Y"
        end
    deactivate Bitacora

    loop por cada fila renderizada (evento gvBitacora_RowDataBound)
        Bitacora -> Bitacora : leer celda Criticidad (columna 4)
        alt celda == "ALTA"
            Bitacora -> Bitacora : celda.CssClass = "criticidad-alta"
        else celda == "MEDIA"
            Bitacora -> Bitacora : celda.CssClass = "criticidad-media"
        else celda == "BAJA"
            Bitacora -> Bitacora : celda.CssClass = "criticidad-baja"
        end
    end

    Bitacora --> Usuario : return 200 OK (grilla renderizada)
end
deactivate Bitacora

== Interacción: Filtrar ==

Usuario -> Bitacora : click btnFiltrar (btnFiltrar_Click)
activate Bitacora
Bitacora -> Bitacora : gvBitacora.PageIndex = 0
Bitacora -> Bitacora : CargarGrilla()
note right: mismo flujo interno detallado en Page_Load
Bitacora --> Usuario : return 200 OK (grilla filtrada)
deactivate Bitacora

== Interacción: Limpiar filtros ==

Usuario -> Bitacora : click btnLimpiar (btnLimpiar_Click)
activate Bitacora
Bitacora -> Bitacora : limpiar fechaDesde, fechaHasta, txtIP\nresetear ddlUsuarios/ddlModulos/ddlCriticidad a indice 0
Bitacora -> Bitacora : gvBitacora.PageIndex = 0
Bitacora -> Bitacora : CargarGrilla()
note right: mismo flujo interno detallado en Page_Load
Bitacora --> Usuario : return 200 OK (grilla sin filtros)
deactivate Bitacora

== Interacción: Cambio de página ==

Usuario -> Bitacora : click página N (gvBitacora_PageIndexChanging)
activate Bitacora
Bitacora -> Bitacora : gvBitacora.PageIndex = e.NewPageIndex
Bitacora -> Bitacora : CargarGrilla()
note right: mismo flujo interno detallado en Page_Load
Bitacora --> Usuario : return 200 OK (página N)
deactivate Bitacora

@enduml
